# Copy to .env. Keep comments on their own lines (docker env_file does not strip inline comments).

# offline = rule-based baseline, no API key. openai / anthropic = LLM with strict JSON schema.
IE_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IE_OPENAI_MODEL=gpt-4o-mini
IE_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Documents scoring at or above this, with no validation errors, skip human review.
IE_AUTO_APPROVE_AT=0.85

# SQLite file. Mounted as a volume in docker-compose.
IE_DB=/data/invoices.db

# Comma-separated key:org pairs. Use long random keys in production.
IE_API_KEYS=change-me:default
IE_RATE_LIMIT_PER_MIN=60
